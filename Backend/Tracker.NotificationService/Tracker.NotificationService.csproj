<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- JwtBearer removed: auth now delegates to AuthService's /verify
         endpoint (OwinStyleAuthHandler in Program.cs), matching TaskService. -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.8" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.4.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Chặn trình biên dịch đọc thư mục Deploy chứa các bản build -->
    <Content Remove="Deploy\**" />
    <Compile Remove="Deploy\**" />
  </ItemGroup>

</Project>