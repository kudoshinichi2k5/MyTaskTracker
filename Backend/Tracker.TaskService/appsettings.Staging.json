{
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://0.0.0.0:5002",
  "AllowedFrontendOrigins": "https://app.staging.yourdomain.com",
  "JwtSettings": {
    "Authority": "https://auth.staging.yourdomain.com/realms/TaskTrackerRealm",
    "Audience": "account",
    "RequireHttpsMetadata": true
  },
  "Keycloak": {
    "BaseUrl": "http://localhost:8080",
    "Realm": "TaskTrackerRealm",
    "AdminClientId": "tasktracker-admin-service",
    "AdminClientSecret": "CHANGE_ME__set_via_Keycloak__AdminClientSecret_env_var_or_dotnet_user-secrets"
  }
}